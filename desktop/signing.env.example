# Скопируй в signing.env (он в .gitignore) и заполни.

# Необязательно: по умолчанию берётся первый «Developer ID Application» из связки ключей
# APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Нотаризация — вариант А (рекомендую): ключ App Store Connect API
# App Store Connect → Users and Access → Integrations → Team Keys → «+», роль Developer
APPLE_API_ISSUER="00000000-0000-0000-0000-000000000000"
APPLE_API_KEY="ABCDE12345"
APPLE_API_KEY_PATH="$HOME/.private_keys/AuthKey_ABCDE12345.p8"

# Нотаризация — вариант Б: Apple ID + app-specific password (appleid.apple.com → Sign-In and Security)
# APPLE_ID="you@example.com"
# APPLE_PASSWORD="abcd-efgh-ijkl-mnop"
# APPLE_TEAM_ID="TEAMID1234"
